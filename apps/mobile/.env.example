# Android emulator default is 10.0.2.2. For a physical phone, use the computer's
# LAN IPv4 address (same Wi-Fi) and make sure Windows Firewall allows the ports.
EXPO_PUBLIC_API_HOST=192.168.1.10

# Optional per-service overrides; if omitted, the host above and these ports are used.
# EXPO_PUBLIC_IDENTITY_API_URL=http://192.168.1.10:3101/api/v1
# EXPO_PUBLIC_SOCIAL_API_URL=http://192.168.1.10:3102/api/v1
# EXPO_PUBLIC_MESSAGES_API_URL=http://192.168.1.10:3103/api/v1
