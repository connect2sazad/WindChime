# =============================================================================
#
#                              connect2sazad
#
# =============================================================================
#
#  File          : .env.example
#  Module        : Application Configuration
#  Type          : Environment Configuration Template
#
#  -----------------------------------------------------------------------------
#  DESCRIPTION
#  -----------------------------------------------------------------------------
#
#  Provides a template for the environment variables required to configure
#  the application across different runtime environments.
#
#  -----------------------------------------------------------------------------
#  RESPONSIBILITIES
#  -----------------------------------------------------------------------------
#
#  - Define application and API configuration variables
#  - Define JWT authentication configuration variables
#  - Define database connection configuration variables
#  - Define frontend and CORS configuration variables
#  - Provide example and default values for local development
#  - Document the environment variables required by the application
#
#  -----------------------------------------------------------------------------
#
#  Author        : connect2sazad
#
# =============================================================================


# =============================================================================
# API Configuration
# =============================================================================

PROJECT_NAME=windchime-identity
PROJECT_TITLE=WindChime Identity
PORT=3101
ENVIRONMENT=development
API_PREFIX=/api/v1
API_VERSION=1.0.0


# =============================================================================
# JWT Configuration
# =============================================================================

# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET_KEY=
JWT_EXPIRES_IN=1d


# ------------------------------------------------------------------------------
# RATE LIMITING
# ------------------------------------------------------------------------------

LOGIN_LIMIT=5


# =============================================================================
# Database Configuration
# =============================================================================

DB_DIALECT=mysql
DB_HOST=localhost
DB_NAME=windchime_identity
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false


# =============================================================================
# Frontend / CORS Configuration
# =============================================================================

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Local: outbox writes private .eml files. Deployment: smtp with Gmail/provider credentials.
MAIL_TRANSPORT=outbox
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Generate a private random key; keep it stable so pending codes survive restarts.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_CODE_SECRET=
